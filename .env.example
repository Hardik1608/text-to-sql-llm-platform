# =============================================================================
# Copy to .env (`cp .env.example .env`, or `make setup`). Never commit .env.
#
# .env is read twice:
#   1. by docker compose, to fill the ${VAR} defaults in docker-compose.yml;
#   2. by the API's Settings (pydantic-settings, prefix T2S_) when you run it on
#      the host with `uvicorn api.main:app`.
# That is why the T2S_* lines below are commented out: compose already passes
# in-network defaults (http://vllm:8000/v1, redis://redis:6379/0, /app/data),
# and host runs fall back to localhost defaults. Uncomment only to override.
# =============================================================================

# ---- API (FastAPI gateway) ----------------------------------------------------
# Admin token for POST /adapters/load and /adapters/unload (X-Admin-Token
# header). Empty = admin endpoints disabled. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
T2S_ADMIN_TOKEN=

# OpenAI-compatible LLM backend URL, including /v1. `make up-gpu` / `make up-cpu`
# set it for you; set it here for an external backend, e.g.
#   http://host.docker.internal:8001/v1   (LLM server running on the host)
# T2S_LLM_BASE_URL=http://vllm:8000/v1
# T2S_LLM_API_KEY=EMPTY
# Model name sent to the backend; defaults to VLLM_MODEL. For Ollama: qwen2.5:3b
# T2S_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# T2S_REDIS_URL=redis://redis:6379/0
# T2S_CACHE_ENABLED=true
# T2S_CACHE_TTL_SECONDS=3600
# T2S_LOG_LEVEL=INFO
# LoRA adapters as comma-separated name=path pairs. Paths are container paths:
# ./adapters is mounted at /adapters in both the api and vllm containers.
# vLLM registers each adapter at startup when <path>/adapter_config.json exists;
# the rest can be hot-loaded later with POST /adapters/load.
# T2S_ADAPTERS=spider-v1=/adapters/spider-v1
# T2S_DATA_DIR is fixed to /app/data inside compose (./data is mounted there).

# ---- GPU backend (profile gpu: vLLM) ----------------------------------------
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
# Default image needs NVIDIA driver >= 580 (CUDA 13). Older driver:
#   VLLM_IMAGE=vllm/vllm-openai:v0.31.0-cu129
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.85
# Must be >= the LoRA rank the adapters were trained with.
VLLM_MAX_LORA_RANK=16
VLLM_MAX_LORAS=4
# Optional: avoids Hugging Face Hub rate limits when downloading weights.
HF_TOKEN=

# ---- CPU backend (profile cpu: Ollama) --------------------------------------
# Pulled on first start. No LoRA support in Ollama: prompt/rag modes only.
# (`make up-cpu` uses its own OLLAMA_MODEL variable: make up-cpu OLLAMA_MODEL=...)
OLLAMA_MODEL=qwen2.5:3b

# ---- Grafana -----------------------------------------------------------------
# Anonymous visitors get read-only Viewer access. The admin credentials apply on
# the first start only (afterwards they live in the grafana-data volume).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Host ports ----------------------------------------------------------------
API_PORT=8000
VLLM_PORT=8001
OLLAMA_PORT=11434
REDIS_PORT=6379
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
MLFLOW_PORT=5000

# Tag/label of the locally built API image.
APP_VERSION=dev
